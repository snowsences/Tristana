rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email == 'allenkevinc@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function entry(date) {
      let d = request.resource.data;
      return d.keys().hasOnly(['date','good','learned','photo','revision','updatedAt','updatedBy'])
        && d.date == date && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.good is string && d.learned is string
        && d.good.size() <= 140 && d.learned.size() <= 140
        && (d.photo == null || d.photo is map)
        && d.revision is int && d.updatedAt is number && d.updatedBy is string;
    }
    match /users/{uid} {
      allow read, create, update: if owner(uid);
      allow delete: if false;
      match /entries/{date} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && entry(date);
        allow delete: if false;
        match /history/{version} {
          allow read, create: if owner(uid);
          allow update, delete: if false;
        }
      }
    }
  }
}
